# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist
/.sanity

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets and local credentials
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
secrets*.json
.npmrc

# local caches, temporary files and editor files
.cache/
.tmp/
tmp/
temp/
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.idea/
.vscode/

# generated QA output; keep drivers, baselines, summaries and master references
/playwright-report/
/test-results/
/blob-report/
/migration/**/*.png
/migration/reports/visual-refinement-candidate*.json
/migration/backups/

# superseded reference export; the authoritative master export is versioned
/morrow-studio-export/
