    {
      "_key": "fd1efacf52bb",
      "_type": "largeStatement",
      "alignment": "left",
      "text": "Rooms that feel found, not designed."
    },
    {
      "_key": "34172ce6df3f",
      "_type": "imagePair",
      "leftImage": {
        "_type": "image",
        "asset": {
          "_ref": "image-608b94ec7bf2d51c0466a5ae2a5e81e6174a6395-1200x1500-jpg",
          "_type": "reference"
        }
      },
      "rightImage": {
        "_type": "image",
        "asset": {
          "_ref": "image-d63b31761a3ed439e87513a65f3c26366a9f4d90-1800x1200-jpg",
          "_type": "reference"
        }
      }
    },
    {
      "_key": "e39626c9ab01",
      "_type": "imageWithText",
      "alt": "Printed guest books and stationery",
      "body": [
        {
          "_key": "f74b01fa32d9",
          "_type": "block",
          "children": [
            {
              "_key": "50dfef578d49",
              "_type": "span",
              "marks": [],
              "text": "A wordmark that sits like a sign painted on a lintel.\nSet in a single weight with generous spacing, the mark is never locked up with a symbol. Each room carries its own number set in the same face — the only ornament in the system."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "image": {
        "_type": "image",
        "asset": {
          "_ref": "image-b1bea83e8e0563ddfef9a35838f2e5d2e6494ec3-1200x1500-jpg",
          "_type": "reference"
        }
      },
      "layout": "imageLeft"
    },
    {
      "_key": "fe984324265b",
      "_type": "textBlock",
      "body": [
        {
          "_key": "36dca98d7291",
          "_type": "block",
          "children": [
            {
              "_key": "b36240797d3f",
              "_type": "span",
              "marks": [],
              "text": "Bookings were moved from a third-party widget into a single, considered page: dates, a room, and a note to the house. Rates are shown in full on the first screen; nothing is upsold."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "79af74b1d2ae",
          "_type": "block",
          "children": [
            {
              "_key": "35ee5daa207a",
              "_type": "span",
              "marks": [],
              "text": "The site is built on a headless CMS so the owners can change the seasonal menu, the room notes and the photography themselves — every page is assembled from the same eleven modules used here."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ]
    },
